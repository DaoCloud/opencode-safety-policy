{
  "description": "适用对象：本机与远端的 Linux 主机。覆盖文件删除（含 Kubernetes 与容器运行时状态目录、find 批量删除、git worktree）、git 强制推送、磁盘与分区（mkfs、dd、fdisk、parted、wipefs、blkdiscard、nvme、LVM、mdadm、ZFS）、关机重启、systemd 服务（含网络服务）、软件包卸载、内核模块卸载、进程、用户、crontab 与日志清理",
  "rules": [
    {
      "id": "rm-system-path",
      "severity": "critical",
      "reason": "禁止删除根目录或系统关键目录",
      "command": "rm",
      "pattern": "(^| )/(\\*|(etc|var|usr|boot|home|data|root|bin|sbin|lib|lib32|lib64|opt|srv|dev|proc|sys|run|mnt|var/lib|usr/local)(/\\*?)?)?( |$)",
      "examples": {
        "match": [
          "rm -rf /",
          "rm -rf --no-preserve-root /",
          "rm -fr /etc/",
          "rm -f /etc/*",
          "rm -rf ../../../..",
          "ssh node1 'rm -rf /var'",
          "cd /tmp && sudo rm -Rf /usr",
          "rm -rf /bin",
          "cd /sbin && rm -rf *",
          "rm -rf /var/lib/",
          "rm -rf /usr/local/*"
        ],
        "ignore": ["rm -rf ./build", "rm /etc/hosts", "rm -rf /etc/app/cache", "rm -rf /usr/local/app", "echo rm -rf /"]
      }
    },
    {
      "id": "rm-k8s-state",
      "severity": "critical",
      "reason": "禁止删除 Kubernetes、etcd 与容器运行时的状态目录",
      "command": "rm",
      "pattern": "(^| )(/var/lib/(etcd(/member)?|kubelet(/pods)?|containerd|docker|cni|calico|rancher(/(k3s|rke2)(/server(/(db(/(etcd(/member)?|state\\.db\\*?))?|tls))?)?)?)|/etc/(kubernetes(/pki|/manifests)?|cni|containerd))(/\\*?)?( |$)",
      "examples": {
        "match": [
          "rm -rf /var/lib/etcd",
          "ssh cp1 'rm -rf /etc/kubernetes'",
          "rm -rf /var/lib/etcd/member/*",
          "cd /var/lib && rm -rf kubelet",
          "rm -rf /var/lib/rancher/k3s",
          "rm -rf /var/lib/kubelet/pods/*",
          "rm -rf /var/lib/rancher/rke2/server/db/etcd",
          "rm -f /var/lib/rancher/k3s/server/db/state.db*",
          "rm -rf /var/lib/rancher/k3s/server/tls"
        ],
        "ignore": ["rm -f /var/lib/etcd/member/snap/tmp.log", "rm -rf /var/lib/rancher/k3s/agent/images", "rm -rf /var/lib/docker-backup", "echo rm -rf /var/lib/etcd"]
      }
    },
    {
      "id": "rm-recursive-variable",
      "severity": "high",
      "reason": "禁止递归删除以变量开头的整段路径（删除目标无法确定，变量为空时 $X/ 会变成根目录）",
      "command": "rm",
      "flags": ["-r", "-R", "--recursive"],
      "pattern": "(^| )\\$(\\w+|\\{\\w+\\})(/\\*?)?( |$)",
      "examples": {
        "match": ["rm -rf $HOME", "rm -rf \"$BUILD_DIR/\"*", "rm -r ${PREFIX}/"],
        "ignore": ["rm -rf \"$BUILD_DIR/out\"", "rm -f $TMPFILE", "echo rm -rf $HOME"]
      }
    },
    {
      "id": "remote-rm",
      "severity": "high",
      "reason": "禁止在远端主机上删除文件",
      "command": ["rm", "rmdir", "unlink"],
      "scope": "remote",
      "examples": {
        "match": ["ssh node1 rm /tmp/x", "ssh -p 2222 root@node1 'rm -f /var/log/app.log'", "kubectl exec api-0 -- rm /data/x"],
        "ignore": ["rm /tmp/x", "ssh node1 ls /tmp", "ssh node1 echo rm /tmp/x"]
      }
    },
    {
      "id": "rm-local",
      "severity": "medium",
      "reason": "删除本机文件需要确认",
      "command": ["rm", "rmdir", "unlink"],
      "scope": "local",
      "examples": {
        "match": ["rm build.log", "rm -rf ./dist", "rmdir empty", "unlink /tmp/sock"],
        "ignore": ["ssh node1 rm /tmp/x", "ls -la", "echo rm build.log"]
      }
    },
    {
      "id": "shred",
      "severity": "high",
      "reason": "禁止不可恢复地擦除文件",
      "command": "shred",
      "examples": {
        "match": ["shred -u secret.txt", "shred -n 3 -z /dev/sdb"],
        "ignore": ["echo shred -u secret.txt", "man shred"]
      }
    },
    {
      "id": "find-delete-system-path",
      "severity": "high",
      "reason": "禁止通过 find 删除根目录、系统目录、主目录或由变量决定的目录下的文件",
      "command": "find",
      "pattern": "^find( -[HLPEXdsx]+| -D \\S+| -O\\d*)*( --)?( [^-(!),\\s]\\S*)*? (/(\\*|(etc|var|usr|boot|home|data|root|bin|sbin|lib|lib32|lib64|opt|srv|dev|proc|sys|run|mnt|var/lib|usr/local|var/lib/(etcd(/member)?|kubelet(/pods)?|containerd|docker|cni|calico|rancher(/(k3s|rke2)(/server(/(db(/(etcd(/member)?|state\\.db\\*?))?|tls))?)?)?)|etc/(kubernetes(/pki|/manifests)?|cni|containerd)|home/[^/\\s]+|Users(/[^/\\s]+)?)(/\\*?)?)?|~[^/\\s]*(/\\*?)?|\\$(\\w+|\\{\\w+\\})(/\\*?)?)(?= |$)(?=.* (-delete|-(exec|execdir|ok|okdir) (\\S*/)?(rm|rmdir|unlink|shred))( |$))",
      "examples": {
        "match": [
          "find / -name core -delete",
          "find /etc -name '*.bak' -exec rm -f {} +",
          "ssh n1 find /var/lib/etcd -type f -delete",
          "cd /usr && find . -delete",
          "ssh n1 'find ~ -name \"*.log\" -delete'",
          "find ./a $DIR -delete",
          "cd / && find -name '*.bak' -delete",
          "ssh n1 find /var/lib/rancher/rke2/server/db -delete",
          "find -- / -delete",
          "find -E \"$X\" -regex '.*\\.log' -delete",
          "find /var/lib/rancher/k3s/server/db/etcd -delete"
        ],
        "ignore": ["find /var/log -name '*.gz' -delete", "find . -name '*.tmp' -delete", "find /etc -name '*.conf'", "echo find / -delete"]
      }
    },
    {
      "id": "find-delete",
      "severity": "high",
      "reason": "禁止在远端主机上通过 find 批量删除文件",
      "command": "find",
      "pattern": "(^| )(-delete|-(exec|execdir|ok|okdir) (\\S*/)?(rm|rmdir|unlink|shred))( |$)",
      "scope": "remote",
      "examples": {
        "match": ["ssh n1 find /var/log -name '*.gz' -delete", "kubectl exec api-0 -- find /data -execdir /bin/rm {} ;"],
        "ignore": ["find . -type f -exec rm -f {} +", "ssh n1 find /var/log -name '*.gz'", "echo ssh n1 find . -delete"]
      }
    },
    {
      "id": "find-delete-local",
      "severity": "medium",
      "reason": "通过 find 删除本机文件需要确认",
      "command": "find",
      "pattern": "(^| )(-delete|-(exec|execdir|ok|okdir) (\\S*/)?(rm|rmdir|unlink|shred))( |$)",
      "scope": "local",
      "examples": {
        "match": ["find . -name '*.tmp' -delete", "find build -type f -exec rm -f {} +"],
        "ignore": ["ssh n1 find /tmp -delete", "find . -exec grep -l TODO {} +", "echo find . -delete"]
      }
    },
    {
      "id": "git-worktree-remove-force",
      "severity": "high",
      "reason": "禁止强制删除 git worktree，未提交的修改和未跟踪文件会丢失",
      "command": "git",
      "subcommands": ["worktree remove"],
      "flags": ["-f", "--force"],
      "examples": {
        "match": ["git worktree remove --force ../wt", "git -C /repo worktree remove -f -f ../wt"],
        "ignore": ["git worktree remove ../wt", "git worktree add -f ../wt main", "echo git worktree remove -f ../wt"]
      }
    },
    {
      "id": "git-push-force",
      "severity": "high",
      "reason": "禁止强制推送，远端分支上的提交会被覆盖",
      "command": "git",
      "subcommands": ["push"],
      "flags": ["-f", "--force"],
      "examples": {
        "match": ["git push --force origin main", "git -C /repo push -uf origin feat"],
        "ignore": ["git push origin main", "git push --force-with-lease origin feat", "echo git push --force"]
      }
    },
    {
      "id": "mkfs",
      "severity": "critical",
      "reason": "禁止格式化文件系统",
      "pattern": "^(mkfs(\\.[\\w-]+)?|mke2fs|mkswap|mkdosfs|mkntfs)( |$)",
      "examples": {
        "match": ["mkfs.ext4 /dev/sdb1", "sudo /sbin/mkfs -t xfs /dev/sdc", "mkswap /dev/sdd2"],
        "ignore": ["echo mkfs.ext4 /dev/sdb1", "man mkfs"]
      }
    },
    {
      "id": "disk-partition",
      "severity": "critical",
      "reason": "禁止修改磁盘分区表",
      "command": ["fdisk", "sfdisk", "gdisk", "cfdisk", "sgdisk", "parted"],
      "pattern": "^\\S+(?!\\S)(?!(?=.* (-l|--list|-x|--list-details|-d|--dump|-J|--json|-p|--print|print|-i ?\\d+|--info[= ]\\d+|-v|-V|--verify|--version|-h|--help)( |$))( (-l|--list|-x|--list-details|-d|--dump|-J|--json|-p|--print|print|-i ?\\d+|--info[= ]\\d+|-v|-V|--verify|--version|-h|--help|-s|--script|-m|--machine|unit \\S+|free|/dev/\\S+)(?= |$))*$)",
      "examples": {
        "match": [
          "fdisk /dev/sdb",
          "parted -s /dev/sdb mklabel gpt",
          "sgdisk --zap-all /dev/nvme0n1",
          "printf 'o\\nw\\n' | fdisk /dev/sdb",
          "sfdisk /dev/sdb",
          "sgdisk -i 1 -d 1 /dev/sdb",
          "parted -s /dev/sdb unit s rm 1"
        ],
        "ignore": [
          "fdisk -l",
          "fdisk -l /dev/sda",
          "fdisk -x /dev/sda",
          "parted -s /dev/sda print",
          "parted /dev/sda unit s print free",
          "sfdisk -d /dev/sda",
          "sfdisk -J /dev/sda",
          "sgdisk -i 1 /dev/sda",
          "echo fdisk /dev/sdb"
        ]
      }
    },
    {
      "id": "wipefs",
      "severity": "critical",
      "reason": "禁止擦除磁盘签名",
      "command": "wipefs",
      "flags": ["-a", "--all", "-o", "--offset"],
      "examples": {
        "match": ["wipefs -a /dev/sdb", "wipefs --all --force /dev/nvme0n1"],
        "ignore": ["wipefs /dev/sdb", "echo wipefs -a /dev/sdb"]
      }
    },
    {
      "id": "disk-secure-erase",
      "severity": "critical",
      "reason": "禁止对磁盘执行丢弃、格式化或安全擦除",
      "command": ["blkdiscard", "nvme", "hdparm"],
      "pattern": "^blkdiscard( |$)|^nvme (format|sanitize|delete-ns)( |$)|^hdparm (.* )?--security-erase(-enhanced)?( |$)",
      "examples": {
        "match": [
          "blkdiscard /dev/nvme0n1",
          "nvme format /dev/nvme0n1 --ses=1",
          "ssh n1 nvme sanitize -a 2 /dev/nvme0",
          "hdparm --user-master u --security-erase p /dev/sdb"
        ],
        "ignore": ["nvme list", "nvme smart-log /dev/nvme0", "hdparm -I /dev/sda", "echo nvme format /dev/nvme0n1"]
      }
    },
    {
      "id": "dd-to-device",
      "severity": "critical",
      "reason": "禁止用 dd 写入块设备",
      "command": "dd",
      "pattern": "(^| )of=/dev/(?!(null|zero|full|tty|stdout|stderr)( |$)|shm/(?!\\S*\\.\\.))",
      "examples": {
        "match": ["dd if=/dev/zero of=/dev/sdb bs=1M", "dd if=image.iso of=/dev/nvme0n1 status=progress", "ssh n1 dd if=x of=/dev/shm/../sda"],
        "ignore": [
          "dd if=/dev/zero of=/tmp/file bs=1M count=10",
          "dd if=/dev/sda of=/dev/null bs=1M count=1",
          "dd if=/dev/zero of=/dev/shm/test bs=1M count=100",
          "echo dd of=/dev/sda"
        ]
      }
    },
    {
      "id": "lvm-remove",
      "severity": "critical",
      "reason": "禁止删除 LVM 逻辑卷、卷组或物理卷",
      "command": ["lvremove", "vgremove", "pvremove"],
      "examples": {
        "match": ["lvremove -f /dev/vg0/data", "vgremove vg0", "pvremove /dev/sdb"],
        "ignore": ["lvs", "vgdisplay vg0", "echo lvremove /dev/vg0/data"]
      }
    },
    {
      "id": "mdadm-destroy",
      "severity": "critical",
      "reason": "禁止停止 RAID 阵列或清除 RAID 超级块",
      "command": "mdadm",
      "flags": ["--stop", "-S", "--zero-superblock"],
      "examples": {
        "match": ["mdadm --stop /dev/md0", "mdadm -S /dev/md0", "mdadm --zero-superblock /dev/sdb1"],
        "ignore": ["mdadm --detail /dev/md0", "echo mdadm --stop /dev/md0"]
      }
    },
    {
      "id": "zfs-destroy",
      "severity": "critical",
      "reason": "禁止销毁 ZFS 数据集或存储池",
      "command": ["zfs", "zpool"],
      "subcommands": ["destroy"],
      "examples": {
        "match": ["zfs destroy -r tank/data", "zpool destroy tank"],
        "ignore": ["zfs list", "zfs snapshot tank/data@backup", "echo zfs destroy tank/data"]
      }
    },
    {
      "id": "host-power",
      "severity": "high",
      "reason": "禁止重启或关闭主机",
      "command": ["reboot", "shutdown", "poweroff", "halt"],
      "pattern": "^(?!shutdown -c( [^-\\s]\\S*)*$)",
      "examples": {
        "match": ["reboot", "sudo shutdown -h now", "ssh node1 poweroff", "shutdown -c -r now"],
        "ignore": ["shutdown -c", "ssh node1 shutdown -c 'maintenance cancelled'", "last reboot", "echo reboot", "systemctl status reboot.target"]
      }
    },
    {
      "id": "init-runlevel",
      "severity": "high",
      "reason": "禁止通过 init 关机或重启",
      "pattern": "^(init|telinit) [06]( |$)",
      "examples": {
        "match": ["init 0", "sudo telinit 6"],
        "ignore": ["init --version", "echo init 0"]
      }
    },
    {
      "id": "systemctl-power",
      "severity": "high",
      "reason": "禁止通过 systemctl 关机、重启或切换到救援模式",
      "command": "systemctl",
      "pattern": "(^| )(reboot|poweroff|halt|kexec|soft-reboot|rescue|emergency|isolate)( |$)|(^| )(start|restart|try-restart|reload-or-restart)( \\S+)* (reboot|poweroff|halt|kexec|soft-reboot|rescue|emergency)\\.target( |$)",
      "examples": {
        "match": [
          "systemctl reboot",
          "sudo systemctl poweroff -i",
          "systemctl isolate rescue.target",
          "systemctl start reboot.target",
          "ssh node1 systemctl --no-block start poweroff.target"
        ],
        "ignore": ["systemctl status", "systemctl status reboot.target", "systemctl start nginx", "echo systemctl reboot"]
      }
    },
    {
      "id": "systemctl-stop",
      "severity": "high",
      "reason": "禁止停止、禁用或屏蔽系统服务",
      "command": ["systemctl", "service"],
      "subcommands": ["stop", "disable", "mask", "kill"],
      "examples": {
        "match": ["systemctl stop nginx", "sudo systemctl disable --now kubelet", "service docker stop", "ssh node1 systemctl mask containerd"],
        "ignore": ["systemctl status nginx", "systemctl restart nginx", "service nginx status", "echo systemctl stop nginx"]
      }
    },
    {
      "id": "net-service-restart",
      "severity": "high",
      "reason": "禁止重启或停止网络服务（会中断连接与路由）",
      "command": ["systemctl", "service"],
      "pattern": "(^| )(restart|stop|reload-or-restart|try-restart)( \\S+)* (networking|network|frr|NetworkManager|systemd-networkd)(\\.service)?( |$)|^service (networking|network|frr|NetworkManager) (restart|stop)( |$)",
      "examples": {
        "match": ["ssh leaf1 sudo systemctl restart networking", "systemctl restart frr.service", "service network restart"],
        "ignore": ["systemctl status frr", "systemctl restart nginx", "echo systemctl restart frr"]
      }
    },
    {
      "id": "pkg-remove",
      "severity": "high",
      "reason": "禁止卸载系统软件包",
      "command": ["apt", "apt-get", "yum", "dnf", "zypper"],
      "subcommands": ["remove", "purge", "autoremove", "erase", "rm"],
      "examples": {
        "match": ["apt-get purge -y openssh-server", "yum remove -y kernel", "zypper rm vim"],
        "ignore": ["apt-get install -y curl", "dnf list installed", "echo apt-get remove -y vim"]
      }
    },
    {
      "id": "rpm-erase",
      "severity": "high",
      "reason": "禁止卸载系统软件包",
      "command": "rpm",
      "flags": ["-e", "--erase"],
      "examples": {
        "match": ["rpm -e kernel-5.14.0", "ssh n1 rpm -e --nodeps openssh-server"],
        "ignore": ["rpm -qa", "rpm -ivh pkg.rpm", "echo rpm -e kernel"]
      }
    },
    {
      "id": "dpkg-remove",
      "severity": "high",
      "reason": "禁止卸载系统软件包",
      "command": "dpkg",
      "flags": ["-r", "--remove", "-P", "--purge"],
      "examples": {
        "match": ["dpkg -r openssh-server", "sudo dpkg --purge linux-image-6.8.0-31-generic"],
        "ignore": ["dpkg -l", "dpkg -i pkg.deb", "echo dpkg -P openssh-server"]
      }
    },
    {
      "id": "kmod-unload",
      "severity": "high",
      "reason": "禁止卸载内核模块（卸载网卡驱动会断网）",
      "command": ["rmmod", "modprobe"],
      "pattern": "^rmmod( |$)|^modprobe (.* )?(-\\w*r\\w*|--remove)( |$)",
      "examples": {
        "match": ["rmmod nvidia", "modprobe -r mlx5_core", "ssh n1 modprobe -rv ib_core"],
        "ignore": ["modprobe mlx5_core", "modprobe --force-vermagic x", "echo rmmod nvidia"]
      }
    },
    {
      "id": "chmod-chown-recursive-root",
      "severity": "critical",
      "reason": "禁止递归修改根目录的权限与属主",
      "command": ["chmod", "chown", "chgrp"],
      "flags": ["-R", "--recursive"],
      "pattern": "(^| )/\\*?( |$)",
      "examples": {
        "match": ["chmod -R 777 /", "sudo chown -R nobody /*", "cd / && chmod -R 755 ."],
        "ignore": ["chmod -R 777 /etc", "chmod 755 /", "echo chmod -R 777 /"]
      }
    },
    {
      "id": "chmod-chown-recursive-system",
      "severity": "high",
      "reason": "禁止递归修改根目录或系统关键目录的权限与属主",
      "command": ["chmod", "chown", "chgrp"],
      "flags": ["-R", "--recursive"],
      "pattern": "(^| )/(\\*|(etc|var|usr|boot|home|data|root|bin|sbin|lib|lib32|lib64|opt|srv|dev|proc|sys|run|mnt|var/lib|usr/local)(/\\*?)?)?( |$)",
      "examples": {
        "match": ["chmod -R 777 /", "chown -R nobody /etc", "chgrp --recursive users /home", "chmod -R 777 /lib"],
        "ignore": ["chmod -R 755 ./dist", "chmod 644 /etc/hosts", "echo chmod -R 777 /"]
      }
    },
    {
      "id": "user-delete",
      "severity": "high",
      "reason": "禁止删除系统用户或用户组",
      "command": ["userdel", "deluser", "groupdel", "delgroup"],
      "examples": {
        "match": ["userdel -r alice", "sudo deluser bob"],
        "ignore": ["id alice", "echo userdel alice"]
      }
    },
    {
      "id": "crontab-remove",
      "severity": "high",
      "reason": "禁止删除整个 crontab",
      "command": "crontab",
      "flags": ["-r"],
      "examples": {
        "match": ["crontab -r", "crontab -u root -r"],
        "ignore": ["crontab -l", "echo crontab -r"]
      }
    },
    {
      "id": "kill-all-processes",
      "severity": "critical",
      "reason": "禁止向所有进程发送信号",
      "command": ["kill", "killall5"],
      "pattern": "^kill( \\S+)+ -1( |$)|^killall5( |$)",
      "examples": {
        "match": ["kill -9 -1", "sudo kill -s KILL -1", "kill -- -1", "killall5 -9"],
        "ignore": ["kill -1 1234", "kill -HUP 1234", "echo kill -9 -1"]
      }
    },
    {
      "id": "kill-process",
      "severity": "medium",
      "reason": "终止进程需要确认",
      "command": ["kill", "pkill", "killall"],
      "examples": {
        "match": ["kill 1234", "pkill -f server.js", "killall nginx"],
        "ignore": ["ps aux", "echo kill 1234"]
      }
    },
    {
      "id": "dmesg-clear",
      "severity": "medium",
      "reason": "清空内核日志缓冲区需要确认",
      "command": "dmesg",
      "flags": ["-C", "-c", "--clear", "--read-clear"],
      "examples": {
        "match": ["dmesg -C", "ssh node1 dmesg -Tc"],
        "ignore": ["dmesg -T", "dmesg --level err", "echo dmesg -C"]
      }
    },
    {
      "id": "journalctl-vacuum",
      "severity": "medium",
      "reason": "清理 systemd 日志需要确认",
      "command": "journalctl",
      "flags": ["--vacuum-size", "--vacuum-time", "--vacuum-files"],
      "examples": {
        "match": ["journalctl --vacuum-time=1d", "ssh node1 journalctl --vacuum-size 100M"],
        "ignore": ["journalctl -u kubelet --since today", "echo journalctl --vacuum-time=1d"]
      }
    },
    {
      "id": "ss-kill",
      "severity": "medium",
      "reason": "强制关闭网络连接需要确认",
      "command": "ss",
      "flags": ["-K", "--kill"],
      "examples": {
        "match": ["ss -K dst 10.0.0.1", "ssh node1 ss -tK sport = :8080"],
        "ignore": ["ss -tlnp", "echo ss -K dst 10.0.0.1"]
      }
    },
    {
      "id": "hostname-set",
      "severity": "medium",
      "reason": "修改主机名需要确认",
      "pattern": "^hostname( -\\w+)* [^- ]|^hostnamectl( -\\S+)* (set-hostname|hostname [^- ])",
      "examples": {
        "match": ["hostname node2", "ssh node1 hostnamectl set-hostname node2", "hostnamectl hostname node2"],
        "ignore": ["hostname", "hostname -f", "hostnamectl status", "hostnamectl hostname", "echo hostname node2"]
      }
    }
  ]
}
