{
  "description": "适用对象：服务器带外管理（BMC）。覆盖 ipmitool、redfishtool，以及发往 Redfish API 的 HTTP 写请求",
  "rules": [
    {
      "id": "ipmitool-power",
      "severity": "critical",
      "reason": "禁止通过 IPMI 断电、复位或重启主机",
      "command": "ipmitool",
      "subcommands": ["power off", "power reset", "power cycle", "power soft", "power diag"],
      "examples": {
        "match": [
          "ipmitool -I lanplus -H 10.0.0.5 -U admin -P secret chassis power off",
          "ipmitool power cycle",
          "ssh jump ipmitool -H bmc1 power reset"
        ],
        "ignore": ["ipmitool -H bmc1 power status", "ipmitool power on", "echo ipmitool power off"]
      }
    },
    {
      "id": "ipmitool-bootdev",
      "severity": "critical",
      "reason": "禁止通过 IPMI 把主机启动设备切换为 PXE 或光驱（会触发重装）",
      "command": "ipmitool",
      "subcommands": ["chassis bootdev pxe", "chassis bootdev cdrom", "chassis bootparam set bootflag"],
      "examples": {
        "match": ["ipmitool -H bmc1 chassis bootdev pxe", "ipmitool chassis bootdev cdrom options=persistent"],
        "ignore": ["ipmitool chassis bootdev disk", "ipmitool chassis bootparam get 5", "echo ipmitool chassis bootdev pxe"]
      }
    },
    {
      "id": "ipmitool-bmc-write",
      "severity": "high",
      "reason": "禁止复位 BMC、发送原始 IPMI 命令或修改 BMC 网络、用户、日志、传感器阈值、FRU、电源恢复策略与固件",
      "command": "ipmitool",
      "subcommands": [
        "mc reset",
        "bmc reset",
        "raw",
        "lan set",
        "user set",
        "user disable",
        "sel clear",
        "sel delete",
        "sensor thresh",
        "sdr fill",
        "fru write",
        "fru edit",
        "fru upgEkey",
        "chassis policy always-on",
        "chassis policy previous",
        "chassis policy always-off",
        "hpm upgrade"
      ],
      "examples": {
        "match": [
          "ipmitool mc reset cold",
          "ipmitool -I lanplus -H bmc1 bmc reset warm",
          "ipmitool -H bmc1 raw 0x30 0x01",
          "ipmitool lan set 1 ipaddr 10.0.0.9",
          "ipmitool -H bmc1 sensor thresh CPU0_Temp upper 80 90 95",
          "ipmitool chassis policy always-off",
          "ssh jump ipmitool -H bmc1 sdr fill sensors"
        ],
        "ignore": [
          "ipmitool mc info",
          "ipmitool sel list",
          "ipmitool chassis policy list",
          "ipmitool -H bmc1 sensor get CPU0_Temp",
          "echo ipmitool mc reset cold"
        ]
      }
    },
    {
      "id": "redfishtool-reset-boot",
      "severity": "critical",
      "reason": "禁止通过 Redfish 复位主机或 BMC、修改启动覆盖项",
      "command": "redfishtool",
      "subcommands": ["reset", "setBootOverride"],
      "examples": {
        "match": [
          "redfishtool -r 10.0.0.5 -u admin -p secret Systems reset ForceOff",
          "redfishtool -r bmc1 Systems setBootOverride Once Pxe",
          "redfishtool -r bmc1 Managers reset"
        ],
        "ignore": ["redfishtool -r bmc1 Systems get", "redfishtool -r bmc1 Systems list", "echo redfishtool Systems reset"]
      }
    },
    {
      "id": "redfishtool-write",
      "severity": "high",
      "reason": "禁止通过 Redfish 修改系统属性、账户、日志、功耗或时间",
      "command": "redfishtool",
      "subcommands": [
        "patch",
        "setAssetTag",
        "setIndicatorLed",
        "clearLog",
        "setPowerLimit",
        "setDateTime",
        "setTimeOffset",
        "setIpAddress",
        "adduser",
        "deleteuser",
        "setpassword",
        "setusername",
        "setSessionTimeout"
      ],
      "examples": {
        "match": ["redfishtool -r bmc1 AccountService adduser bob pass Operator", "redfishtool -r bmc1 Systems Logs clearLog SEL"],
        "ignore": ["redfishtool -r bmc1 AccountService Accounts list", "echo redfishtool AccountService adduser bob"]
      }
    },
    {
      "id": "redfishtool-raw-write",
      "severity": "high",
      "reason": "禁止通过 redfishtool raw 发送 Redfish 写请求",
      "command": "redfishtool",
      "pattern": "(^| )raw (?i:post|patch|put|delete)( |$)",
      "examples": {
        "match": [
          "redfishtool -r bmc1 raw POST /redfish/v1/Systems/1/Actions/ComputerSystem.Reset",
          "redfishtool -r bmc1 raw patch /redfish/v1/Systems/1"
        ],
        "ignore": ["redfishtool -r bmc1 raw GET /redfish/v1/Systems", "echo redfishtool raw POST /redfish/v1"]
      }
    },
    {
      "id": "redfish-power-reset",
      "severity": "critical",
      "reason": "禁止通过 Redfish 对主机或机箱断电、复位或重启",
      "http": {
        "methods": ["POST", "PUT", "PATCH", "DELETE"],
        "urlPatterns": ["/redfish/v1/.*Actions/(ComputerSystem|Chassis)\\.Reset"]
      },
      "examples": {
        "match": [
          "curl -k -u admin:pw -X POST https://10.0.0.5/redfish/v1/Systems/1/Actions/ComputerSystem.Reset -d '{\"ResetType\":\"ForceOff\"}'",
          "ssh jump curl -sk -d '{\"ResetType\":\"ForceRestart\"}' https://bmc1/redfish/v1/Systems/System.Embedded.1/Actions/ComputerSystem.Reset",
          "http POST bmc1/redfish/v1/Chassis/1/Actions/Chassis.Reset ResetType=PowerCycle",
          "python3 -c 'import requests; requests.post(\"https://bmc1/redfish/v1/Systems/1/Actions/ComputerSystem.Reset\", json=body)'"
        ],
        "ignore": [
          "curl -sk https://bmc1/redfish/v1/Systems/1",
          "curl -sk https://bmc1/redfish/v1/Systems/1/ResetActionInfo",
          "echo curl -X POST https://bmc1/redfish/v1/Systems/1/Actions/ComputerSystem.Reset"
        ]
      }
    },
    {
      "id": "redfish-virtual-media",
      "severity": "critical",
      "reason": "禁止通过 Redfish 挂载、弹出或修改虚拟介质（可触发重装）",
      "http": {
        "methods": ["POST", "PUT", "PATCH", "DELETE"],
        "urlPatterns": ["/redfish/v1/.*(VirtualMedia\\.(InsertMedia|EjectMedia)|/VirtualMedia/[^/?#]+/?($|[?#]))"]
      },
      "examples": {
        "match": [
          "curl -k -X POST https://bmc1/redfish/v1/Managers/1/VirtualMedia/CD1/Actions/VirtualMedia.InsertMedia -d '{\"Image\":\"http://repo/os.iso\"}'",
          "curl -k -X PATCH https://bmc1/redfish/v1/Managers/1/VirtualMedia/CD1 -d '{\"Image\":\"http://repo/os.iso\",\"Inserted\":true}'",
          "wget -qO- --method=POST --body-data '{}' https://bmc1/redfish/v1/Systems/1/VirtualMedia/1/Actions/VirtualMedia.EjectMedia"
        ],
        "ignore": [
          "curl -k https://bmc1/redfish/v1/Managers/1/VirtualMedia/CD1",
          "curl -k -X POST https://bmc1/redfish/v1/Managers/1/VirtualMedia/CD1/Actions/Oem.Info",
          "echo curl -X POST https://bmc1/redfish/v1/Managers/1/VirtualMedia/CD1/Actions/VirtualMedia.InsertMedia"
        ]
      }
    },
    {
      "id": "redfish-boot-override",
      "severity": "critical",
      "reason": "禁止通过 Redfish 修改主机的一次性或持久启动设备（可触发重装）",
      "http": {
        "methods": ["PATCH", "PUT", "POST"],
        "urlPatterns": ["/redfish/v1/Systems/"],
        "bodyPatterns": ["BootSourceOverride"]
      },
      "examples": {
        "match": [
          "curl -k -X PATCH https://bmc1/redfish/v1/Systems/1 -d '{\"Boot\":{\"BootSourceOverrideTarget\":\"Pxe\"}}'",
          "curl -k -X PATCH https://bmc1/redfish/v1/Systems/1 -d @boot.json",
          "http PATCH bmc1/redfish/v1/Systems/1 Boot:='{\"BootSourceOverrideTarget\":\"Cd\"}'"
        ],
        "ignore": [
          "curl -k -X PATCH https://bmc1/redfish/v1/Systems/1 -d '{\"AssetTag\":\"rack1\"}'",
          "curl -k 'https://bmc1/redfish/v1/Systems/1?$select=Boot/BootSourceOverrideTarget'",
          "echo curl -X PATCH https://bmc1/redfish/v1/Systems/1 -d BootSourceOverrideTarget"
        ]
      }
    },
    {
      "id": "redfish-bmc-reset",
      "severity": "critical",
      "reason": "禁止通过 Redfish 复位 BMC 或将 BMC 恢复出厂设置",
      "http": {
        "methods": ["POST", "PUT", "PATCH", "DELETE"],
        "urlPatterns": ["/redfish/v1/.*Actions/Manager\\.(Reset|ResetToDefaults)"]
      },
      "examples": {
        "match": [
          "curl -k -X POST https://bmc1/redfish/v1/Managers/1/Actions/Manager.Reset -d '{\"ResetType\":\"GracefulRestart\"}'",
          "curl -k -X POST https://bmc1/redfish/v1/Managers/iDRAC.Embedded.1/Actions/Manager.ResetToDefaults -d '{\"ResetType\":\"ResetAll\"}'"
        ],
        "ignore": [
          "curl -k https://bmc1/redfish/v1/Managers/1",
          "echo curl -X POST https://bmc1/redfish/v1/Managers/1/Actions/Manager.Reset"
        ]
      }
    },
    {
      "id": "redfish-firmware-update",
      "severity": "critical",
      "reason": "禁止通过 Redfish 更新或修改固件更新服务",
      "http": {
        "methods": ["POST", "PUT", "PATCH", "DELETE"],
        "urlPatterns": ["/redfish/v1/UpdateService"]
      },
      "examples": {
        "match": [
          "curl -k -X POST https://bmc1/redfish/v1/UpdateService/Actions/UpdateService.SimpleUpdate -d '{\"ImageURI\":\"http://repo/bios.bin\"}'",
          "curl -k -F UpdateFile=@bios.bin https://bmc1/redfish/v1/UpdateService/upload"
        ],
        "ignore": [
          "curl -k https://bmc1/redfish/v1/UpdateService/FirmwareInventory",
          "echo curl -X POST https://bmc1/redfish/v1/UpdateService/Actions/UpdateService.SimpleUpdate"
        ]
      }
    },
    {
      "id": "redfish-write",
      "severity": "high",
      "reason": "禁止通过 Redfish 修改 BMC 或主机配置（登录会话除外）",
      "http": {
        "methods": ["POST", "PUT", "PATCH", "DELETE"],
        "urlPatterns": ["/redfish/v1/(?!SessionService/Sessions(/|$|\\?))"]
      },
      "examples": {
        "match": [
          "curl -k -X PATCH https://bmc1/redfish/v1/AccountService/Accounts/3 -d '{\"Password\":\"x\"}'",
          "curl -k -X DELETE https://bmc1/redfish/v1/Systems/1/LogServices/SEL/Entries/1",
          "curl -k -X \"$METHOD\" https://bmc1/redfish/v1/Systems/1"
        ],
        "ignore": [
          "curl -k -u admin:pw https://bmc1/redfish/v1/Systems/1",
          "curl -k -X POST https://bmc1/redfish/v1/SessionService/Sessions -d '{\"UserName\":\"admin\",\"Password\":\"x\"}'",
          "echo curl -X DELETE https://bmc1/redfish/v1/Systems/1"
        ]
      }
    }
  ]
}
